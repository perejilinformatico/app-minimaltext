---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es" data-theme="minimaltext">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MinimalText - App de texto minimalista" />
    <link rel="icon" type="image/svg+xml" href="/favicon-org.svg" />
    <meta name="google-site-verification" content="yg1wGesWNcisqQrCiw8y7VngA1J6_9ui1HSlyKV605A" />
    <title>MinimalText - App de notas con IA</title>
    <meta property="og:title" content="MinimalText - App de notas con IA" />
    <meta property="og:image" content="https://app-minimaltext.vercel.app/favicon-org.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Santiago Cussit Maximo" />
    <meta property="og:type" content="website">
  </head>
  <body class="min-h-screen flex flex-col bg-[#1a1a1a] text-white">
    <Header />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>