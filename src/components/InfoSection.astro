<section id="info" class="py-12 sm:py-20 px-4 sm:px-6 bg-[#1a1a1a]">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-white text-center mb-8 sm:mb-12">
      ¿Por qué MinimalText?
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      <div class="card bg-[#0d0d0d] border border-white/10">
        <div class="card-body">
          <h3 class="card-title text-[#4ade80] text-xl">Acordamiento</h3>
          <p class="text-gray-400">
            Organiza tus notas de manera inteligente para que nunca pierdas detalle importante.
          </p>
        </div>
      </div>
      <div class="card bg-[#0d0d0d] border border-white/10">
        <div class="card-body">
          <h3 class="card-title text-[#4ade80] text-xl">Ordenamiento</h3>
          <p class="text-gray-400">
            Estructura tus textos con facilidad. Ordena, categoriza y encuentra lo que necesitas al instante.
          </p>
        </div>
      </div>
      <div class="card bg-[#0d0d0d] border border-white/10">
        <div class="card-body">
          <h3 class="card-title text-[#4ade80] text-xl">Mejora de Textos</h3>
          <p class="text-gray-400">
            Herramientas potentes para corregir, formatear y pulir tus escritos hasta la perfección.
          </p>
        </div>
      </div>
      <div class="card bg-[#0d0d0d] border border-white/10">
        <div class="card-body">
          <h3 class="card-title text-[#4ade80] text-xl">Notas Optimizadas</h3>
          <p class="text-gray-400">
            La mejor experiencia para tomar notas. Rápido, limpio y totalmente personalizado.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>